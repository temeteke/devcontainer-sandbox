#!/usr/bin/env bash
set -euo pipefail

readonly IMAGE_PREFIX='mcr.microsoft.com/devcontainers/'
readonly FEATURE_PREFIX='ghcr.io/temeteke/devcontainer-features'
readonly DEVCONTAINER_FEATURES='ghcr.io/devcontainers/features'
readonly DEFAULT_IMAGE="${IMAGE_PREFIX}base:ubuntu24.04"

# Components. The first positional argument is a comma-separated list of
# component names. A component may carry a base image, Dev Container Features
# (space separated), and the command to run when it is the first component that
# has one. Add a component with one add_component line. A component contributes
# its image when no image is set yet; otherwise its Features are added, so a
# language component can be layered onto another language's image. `base` is
# appended last unless it is named, so `dcs` alone starts a bash shell. The tmux
# and Vim Features bind-mount host files (see README).
COMPONENT_NAMES=()
declare -A COMPONENT_IMAGE=()
declare -A COMPONENT_FEATURES=()
declare -A COMPONENT_COMMAND=()
add_component() {
  COMPONENT_NAMES+=("$1")
  COMPONENT_IMAGE[$1]="$2"
  COMPONENT_FEATURES[$1]="$3"
  COMPONENT_COMMAND[$1]="$4"
}

add_component python   "${IMAGE_PREFIX}python:latest"          "${DEVCONTAINER_FEATURES}/python:1" python
add_component node     "${IMAGE_PREFIX}javascript-node:latest" "${DEVCONTAINER_FEATURES}/node:1"   node
add_component go       "${IMAGE_PREFIX}go:latest"              "${DEVCONTAINER_FEATURES}/go:1"     bash
add_component rust     "${IMAGE_PREFIX}rust:latest"            "${DEVCONTAINER_FEATURES}/rust:1"   bash
add_component opencode '' "$FEATURE_PREFIX/opencode:0"         opencode
add_component codex    '' "$FEATURE_PREFIX/codex:0"            codex
add_component claude   '' "$FEATURE_PREFIX/claude-code:0"      claude
add_component tmux     '' "$FEATURE_PREFIX/tmux:0"             tmux
add_component vim      '' "$FEATURE_PREFIX/vim:0"              vim
add_component base     "$DEFAULT_IMAGE" ''                     ''

# Strip the known registry prefixes so the help reads as python:latest,
# python:1 and so on.
short_ref() {
  case "$1" in
    "$IMAGE_PREFIX"*) printf '%s' "${1#"$IMAGE_PREFIX"}" ;;
    "$DEVCONTAINER_FEATURES"/*) printf '%s' "${1#"$DEVCONTAINER_FEATURES"/}" ;;
    "$FEATURE_PREFIX"/*) printf '%s' "${1#"$FEATURE_PREFIX"/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

component_list() {
  local name detail feature
  for name in "${COMPONENT_NAMES[@]}"; do
    detail=''
    if [[ -n "${COMPONENT_IMAGE[$name]}" ]]; then
      detail="image $(short_ref "${COMPONENT_IMAGE[$name]}")"
    fi
    # Unquoted on purpose: split the space-separated Feature list (no globs).
    for feature in ${COMPONENT_FEATURES[$name]}; do
      detail+="${detail:+ / }feature $(short_ref "$feature")"
    done
    [[ -n "$detail" ]] || detail='(nothing)'
    printf '  %-9s %-46s %s\n' "$name" "$detail" "${COMPONENT_COMMAND[$name]:--}"
  done
}

usage() {
  cat <<HELP
Usage: dcs [OPTIONS] [COMPONENT[,COMPONENT...]] [COMMAND [ARG ...]]

Run a command in a new, disposable Dev Container.

  --image IMAGE       Base image (counts as an image set before the components)
  --feature REF       Add a Dev Container Feature by full reference (repeatable)
  -h, --help          Show this help
  --                  End of options; treat the rest as COMMAND and its arguments

Options come before the component list.

Components (name, what it adds, default command):
$(component_list)

Name zero or more components, separated by commas. They are processed in order:
a component that carries an image sets it when no image is set yet, and its
Features are added otherwise. So 'dcs python,node' uses the Python image and
adds the Node Feature, and both languages are available. A component name that
contains '/' or ':' is used as a base image reference. The first component that
carries a command is run, and bash runs when none does. base is appended as the
fallback when it is not named, so 'dcs' alone starts a bash shell.

Everything after the component list is the container command. A command name
runs instead of the default command (for example, 'dcs opencode bash'). Options
are passed to the default command instead (for example, 'dcs opencode --help'
runs 'opencode --help'). The current working directory is passed to Dev
Container CLI as the workspace folder; the container is deleted on exit while
built images may remain cached.
HELP
}

die() { printf 'dcs: %s\n' "$*" >&2; exit 1; }

components_arg=''
image_option=''
features=()
run_command=()
components_seen=0
append_default=0
while (($#)); do
  # Options come before the component list. Everything after the component
  # list belongs to the container command.
  if ((components_seen == 1)); then
    case "$1" in
      --) shift ;;
      -*) append_default=1 ;;
    esac
    run_command=("$@")
    break
  fi
  case "$1" in
    --image|--feature)
      opt="$1"
      (($# >= 2)) || die "missing value for $opt"
      [[ -n "$2" && "$2" != --* ]] || die "missing value for $opt"
      if [[ "$opt" == --image ]]; then image_option="$2"; else features+=("$2"); fi
      shift 2 ;;
    --)
      shift
      run_command=("$@")
      break ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *)
      # The first non-option argument is the component list.
      components_arg="$1"
      components_seen=1
      shift ;;
  esac
done

component_names=()
if [[ -n "$components_arg" ]]; then
  IFS=',' read -r -a component_names <<< "$components_arg"
fi

# Validate every token. A token that is not a component but contains '/' or ':'
# is taken as a base image reference. base stays where it is when named, and is
# appended otherwise so it is always available as a fallback.
selected=()
base_present=0
if ((${#component_names[@]})); then
  for name in "${component_names[@]}"; do
    [[ -n "$name" ]] || { usage >&2; die "empty component name in: $components_arg"; }
    if [[ -n "${COMPONENT_FEATURES[$name]+x}" ]]; then
      [[ "$name" == base ]] && base_present=1
      selected+=("$name")
    elif [[ "$name" == */* || "$name" == *:* ]]; then
      selected+=("$name")
    else
      usage >&2
      die "unknown component: $name"
    fi
  done
fi
((base_present)) || selected+=(base)
component_names=("${selected[@]}")

# Resolve the image, the default command and the Feature set in one ordered
# pass. A component contributes its image when none is set yet; otherwise its
# Features are added (so a language can be layered onto another language's
# image). --image counts as an already-set image. Inline image references and
# the first command behave the same way as before.
resolved_image="$image_option"
default_command=''
declare -A seen_components=()
declare -A seen_features=()
all_features=()
for name in "${component_names[@]}"; do
  if [[ -z "${COMPONENT_FEATURES[$name]+x}" ]]; then
    # Not a component: an inline base image reference.
    [[ -n "$resolved_image" ]] || resolved_image="$name"
    continue
  fi
  [[ -z "${seen_components[$name]:-}" ]] || continue
  seen_components[$name]=1
  if [[ -n "${COMPONENT_IMAGE[$name]}" && -z "$resolved_image" ]]; then
    # This component provides the image, so its Feature is already included.
    resolved_image="${COMPONENT_IMAGE[$name]}"
  else
    # Unquoted on purpose: split the space-separated Feature list (no globs).
    for feature in ${COMPONENT_FEATURES[$name]}; do
      if [[ -z "${seen_features[$feature]+x}" ]]; then
        seen_features[$feature]=1
        all_features+=("$feature")
      fi
    done
  fi
  if [[ -z "$default_command" && -n "${COMPONENT_COMMAND[$name]}" ]]; then
    default_command="${COMPONENT_COMMAND[$name]}"
  fi
done
if ((${#features[@]})); then
  for feature in "${features[@]}"; do
    if [[ -z "${seen_features[$feature]+x}" ]]; then
      seen_features[$feature]=1
      all_features+=("$feature")
    fi
  done
fi

image="$resolved_image"
[[ -n "$image" ]] || image="$DEFAULT_IMAGE"

if ((${#run_command[@]} == 0)); then
  if [[ -n "$default_command" ]]; then
    run_command=("$default_command")
  else
    run_command=(bash)
  fi
elif ((append_default)) && [[ -n "$default_command" ]]; then
  # Options given after the component list are passed to the default command.
  run_command=("$default_command" "${run_command[@]}")
fi

for cmd in docker devcontainer; do
  command -v "$cmd" >/dev/null 2>&1 || die "$cmd is required"
done

docker info >/dev/null 2>&1 || die 'cannot connect to Docker; check the daemon and permissions'

workspace="$(pwd -P)"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/dcs.XXXXXXXX")" || die 'unable to create temporary directory'
readonly tmp
session="$(cat /proc/sys/kernel/random/uuid)" || die 'unable to generate a session ID'
readonly session

cleanup() {
  local status=$?
  trap - EXIT INT TERM
  # Keep the wrapped command's exit status even if cleanup itself fails.
  set +e
  local ids
  if ! ids="$(docker ps -aq --filter "label=dcs.session=$session")"; then
    printf 'dcs: warning: unable to locate containers for cleanup (session %s)\n' "$session" >&2
  elif [[ -n "$ids" ]]; then
    # IDs are Docker-generated hex tokens, one per line.
    local id
    while IFS= read -r id; do
      if [[ -n "$id" ]] && ! docker rm -f "$id" >/dev/null; then
        printf 'dcs: warning: failed to remove container %s\n' "$id" >&2
      fi
    done <<< "$ids"
  fi
  rm -rf -- "$tmp"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Emit a JSON string. Values are image and Feature references, so escaping \\
# and " is enough; shell data is never interpolated unescaped.
json_string() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

{
  printf '{\n'
  printf '  "name": "dcs sandbox",\n'
  printf '  "image": %s,\n' "$(json_string "$image")"
  printf '  "features": {'
  separator=''
  if ((${#all_features[@]})); then
    for feature in "${all_features[@]}"; do
      printf '%s%s: {}' "$separator" "$(json_string "$feature")"
      separator=', '
    done
  fi
  printf '}\n'
  printf '}\n'
} > "$tmp/devcontainer.json"

printf 'dcs: creating a disposable container for %s\n' "$workspace" >&2

# Use an explicit external config to ignore any existing workspace .devcontainer.
# --id-label guarantees concurrent runs never share/reuse the same container.
devcontainer up \
  --workspace-folder "$workspace" \
  --config "$tmp/devcontainer.json" \
  --id-label "dcs.session=$session" \
  --no-lockfile || die 'devcontainer up failed'

# Do not replace this shell: the EXIT trap must remove the container.
# exec looks the container up from the same dcs.session label.
status=0
devcontainer exec \
  --workspace-folder "$workspace" \
  --config "$tmp/devcontainer.json" \
  --id-label "dcs.session=$session" \
  -- "${run_command[@]}" || status=$?
exit "$status"
