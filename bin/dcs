#!/usr/bin/env bash
set -euo pipefail

readonly FEATURE_PREFIX='ghcr.io/temeteke/devcontainer-features'
readonly DEFAULT_IMAGE='mcr.microsoft.com/devcontainers/base:ubuntu24.04'

# Profiles. The first positional argument selects one, and each profile lists
# every Dev Container Feature it installs (space separated). Add a profile with
# one add_profile line; omit tmux/Vim for a bare sandbox. The tmux and Vim
# Features bind-mount host files (see README).
PROFILE_NAMES=()
declare -A PROFILE_FEATURES=()
add_profile() {
  PROFILE_NAMES+=("$1")
  PROFILE_FEATURES[$1]="$2"
}

add_profile minimal  ''
add_profile base     "$FEATURE_PREFIX/tmux:0 $FEATURE_PREFIX/vim:0"
add_profile opencode "$FEATURE_PREFIX/tmux:0 $FEATURE_PREFIX/vim:0 $FEATURE_PREFIX/opencode:0"
add_profile codex    "$FEATURE_PREFIX/tmux:0 $FEATURE_PREFIX/vim:0 $FEATURE_PREFIX/codex:0"
add_profile claude   "$FEATURE_PREFIX/tmux:0 $FEATURE_PREFIX/vim:0 $FEATURE_PREFIX/claude-code:0"

profile_list() {
  local name feature shown
  for name in "${PROFILE_NAMES[@]}"; do
    shown=''
    # Unquoted on purpose: split the space-separated Feature list (no globs).
    for feature in ${PROFILE_FEATURES[$name]}; do
      shown+="${shown:+ }${feature#"$FEATURE_PREFIX"/}"
    done
    printf '  %-9s %s\n' "$name" "${shown:-(none)}"
  done
}

usage() {
  cat <<HELP
Usage: dcs <PROFILE> [--image IMAGE] [--feature FEATURE ...] [--] [COMMAND [ARG ...]]

Run a command in a new, disposable Dev Container.

  --image IMAGE       Base image (default: $DEFAULT_IMAGE)
  --feature FEATURE   Add a Dev Container Feature (repeatable)
  --                  End of options; treat the rest as COMMAND and its arguments
  -h, --help          Show this help

Profiles (Features added on top of the base image):
$(profile_list)

With no COMMAND, an interactive bash shell is started. Otherwise COMMAND is run
inside the container. The first argument that is not an option starts COMMAND,
and every following argument is passed through as-is (use -- when COMMAND itself
begins with a dash).

Each profile installs its own set of Features. The current working directory is
passed to Dev Container CLI as the workspace folder; Dev Container CLI chooses
the mount root. Existing .devcontainer is ignored. Agent state and terminal
settings are shared from the host by those Features. The container is deleted on
exit; built images may remain cached.
HELP
}

die() { printf 'dcs: %s\n' "$*" >&2; exit 1; }

if [[ $# -eq 0 ]]; then usage >&2; exit 2; fi
case "$1" in
  -h|--help) usage; exit 0 ;;
  *) profile="$1"; shift ;;
esac
[[ -n "${PROFILE_FEATURES[$profile]+x}" ]] || { usage >&2; die "unknown profile: $profile"; }

image="$DEFAULT_IMAGE"
features=()
run_command=()
while (($#)); do
  case "$1" in
    --image|--feature)
      opt="$1"
      (($# >= 2)) || die "missing value for $opt"
      [[ -n "$2" && "$2" != --* ]] || die "missing value for $opt"
      if [[ "$opt" == --image ]]; then image="$2"; else features+=("$2"); fi
      shift 2 ;;
    --)
      shift
      run_command=("$@")
      break ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *)
      # The first non-option argument starts the in-container command.
      run_command=("$@")
      break ;;
  esac
done
if ((${#run_command[@]} == 0)); then
  run_command=(bash)
fi

for cmd in docker devcontainer; do
  command -v "$cmd" >/dev/null 2>&1 || die "$cmd is required"
done

docker info >/dev/null 2>&1 || die 'cannot connect to Docker; check the daemon and permissions'

workspace="$(pwd -P)"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/dcs.XXXXXXXX")" || die 'unable to create temporary directory'
readonly tmp
session="$(cat /proc/sys/kernel/random/uuid)" || die 'unable to generate a session ID'
readonly session

cleanup() {
  local status=$?
  trap - EXIT INT TERM
  local ids
  if ! ids="$(docker ps -aq --filter "label=dcs.session=$session")"; then
    printf 'dcs: warning: unable to locate containers for cleanup (session %s)\n' "$session" >&2
  elif [[ -n "$ids" ]]; then
    # IDs are Docker-generated hex tokens, one per line.
    local id
    while IFS= read -r id; do
      if [[ -n "$id" ]] && ! docker rm -f "$id" >/dev/null; then
        printf 'dcs: warning: failed to remove container %s\n' "$id" >&2
      fi
    done <<< "$ids"
  fi
  rm -rf -- "$tmp"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

profile_features=()
if [[ -n "${PROFILE_FEATURES[$profile]}" ]]; then
  read -r -a profile_features <<< "${PROFILE_FEATURES[$profile]}"
fi

# Emit a JSON string. Values are image and Feature references, so escaping \\
# and " is enough; shell data is never interpolated unescaped.
json_string() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

# A Feature that is both in the profile and passed via --feature yields a
# repeated key; JSON parsers keep the last, and every value is {}.
{
  printf '{\n'
  printf '  "name": "dcs sandbox",\n'
  printf '  "image": %s,\n' "$(json_string "$image")"
  printf '  "features": {'
  separator=''
  for feature in "${profile_features[@]}" "${features[@]}"; do
    printf '%s%s: {}' "$separator" "$(json_string "$feature")"
    separator=', '
  done
  printf '}\n'
  printf '}\n'
} > "$tmp/devcontainer.json"

printf 'dcs: creating a disposable container for %s\n' "$workspace" >&2

# Use an explicit external config to ignore any existing workspace .devcontainer.
# --id-label guarantees concurrent runs never share/reuse the same container.
devcontainer up \
  --workspace-folder "$workspace" \
  --config "$tmp/devcontainer.json" \
  --id-label "dcs.session=$session" \
  --no-lockfile || die 'devcontainer up failed'

# Do not replace this shell: the EXIT trap must remove the container.
# exec looks the container up from the same dcs.session label.
status=0
devcontainer exec \
  --workspace-folder "$workspace" \
  --config "$tmp/devcontainer.json" \
  --id-label "dcs.session=$session" \
  -- "${run_command[@]}" || status=$?
exit "$status"
