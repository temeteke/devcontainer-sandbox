#!/usr/bin/env bash
set -euo pipefail

readonly IMAGE_PREFIX='mcr.microsoft.com/devcontainers/'
readonly FEATURE_PREFIX='ghcr.io/temeteke/devcontainer-features'
readonly DEVCONTAINER_FEATURES='ghcr.io/devcontainers/features'
readonly DEFAULT_IMAGE="${IMAGE_PREFIX}base:ubuntu24.04"

# Components. The first positional argument is a comma-separated list of
# component names. A component may carry a base image, one Dev Container
# Feature with its options, and the command to run when it is the first
# component that has one. Add a component with one add_component line. A
# component contributes its image when no image is set yet; otherwise its
# Feature is added, so a language component can be layered onto another
# language's image. `base` is appended last unless it is named; bash is the
# fallback when no component carries a command, so `dcs` alone starts a shell.
# The tmux and Vim Features bind-mount host files (see README).
COMPONENT_NAMES=()
declare -A COMPONENT_IMAGE=()
declare -A COMPONENT_FEATURE=()
declare -A COMPONENT_FEATURE_OPTIONS=()
declare -A COMPONENT_COMMAND=()
# add_component NAME IMAGE FEATURE [FEATURE_OPTIONS] COMMAND
# COMMAND is an argv: whitespace separates its arguments and it is never
# evaluated by a shell.
add_component() {
  COMPONENT_NAMES+=("$1")
  COMPONENT_IMAGE[$1]="$2"
  COMPONENT_FEATURE[$1]="$3"
  COMPONENT_FEATURE_OPTIONS[$1]="$4"
  COMPONENT_COMMAND[$1]="$5"
}

add_component base          "$DEFAULT_IMAGE"                        ''                                  ''                  ''
add_component python        "${IMAGE_PREFIX}python:latest"          "${DEVCONTAINER_FEATURES}/python:1" ''                  python
add_component "python:3.14" "${IMAGE_PREFIX}python:3.14"            "${DEVCONTAINER_FEATURES}/python:1" '{"version":"3.14"}' python
add_component "python:3.13" "${IMAGE_PREFIX}python:3.13"            "${DEVCONTAINER_FEATURES}/python:1" '{"version":"3.13"}' python
add_component "python:3.12" "${IMAGE_PREFIX}python:3.12"            "${DEVCONTAINER_FEATURES}/python:1" '{"version":"3.12"}' python
add_component "python:3.11" "${IMAGE_PREFIX}python:3.11"            "${DEVCONTAINER_FEATURES}/python:1" '{"version":"3.11"}' python
add_component "python:3.10" "${IMAGE_PREFIX}python:3.10"            "${DEVCONTAINER_FEATURES}/python:1" '{"version":"3.10"}' python
add_component node          "${IMAGE_PREFIX}javascript-node:latest" "${DEVCONTAINER_FEATURES}/node:1"   ''                  node
add_component "node:24"     "${IMAGE_PREFIX}javascript-node:24"     "${DEVCONTAINER_FEATURES}/node:1"   '{"version":"24"}'   node
add_component "node:22"     "${IMAGE_PREFIX}javascript-node:22"     "${DEVCONTAINER_FEATURES}/node:1"   '{"version":"22"}'   node
add_component "node:20"     "${IMAGE_PREFIX}javascript-node:20"     "${DEVCONTAINER_FEATURES}/node:1"   '{"version":"20"}'   node
add_component go            "${IMAGE_PREFIX}go:latest"              "${DEVCONTAINER_FEATURES}/go:1"     ''                  ''
add_component "go:1.27"     "${IMAGE_PREFIX}go:1.27"                "${DEVCONTAINER_FEATURES}/go:1"     '{"version":"1.27"}' ''
add_component "go:1.26"     "${IMAGE_PREFIX}go:1.26"                "${DEVCONTAINER_FEATURES}/go:1"     '{"version":"1.26"}' ''
add_component "go:1.25"     "${IMAGE_PREFIX}go:1.25"                "${DEVCONTAINER_FEATURES}/go:1"     '{"version":"1.25"}' ''
# Rust images only publish a major tag, so versioned Rust components are
# Feature-only: they run on whatever image the other components chose.
add_component rust          "${IMAGE_PREFIX}rust:latest"            "${DEVCONTAINER_FEATURES}/rust:1"   ''                  ''
add_component "rust:1.87"   ''                                      "${DEVCONTAINER_FEATURES}/rust:1"   '{"version":"1.87"}' ''
add_component "rust:1.86"   ''                                      "${DEVCONTAINER_FEATURES}/rust:1"   '{"version":"1.86"}' ''
add_component "rust:1.85"   ''                                      "${DEVCONTAINER_FEATURES}/rust:1"   '{"version":"1.85"}' ''
add_component java          "${IMAGE_PREFIX}java:latest"            "${DEVCONTAINER_FEATURES}/java:1"   ''                  ''
add_component "java:25"     "${IMAGE_PREFIX}java:25"                "${DEVCONTAINER_FEATURES}/java:1"   '{"version":"25"}'  ''
add_component "java:21"     "${IMAGE_PREFIX}java:21"                "${DEVCONTAINER_FEATURES}/java:1"   '{"version":"21"}'  ''
add_component "java:17"     "${IMAGE_PREFIX}java:17"                "${DEVCONTAINER_FEATURES}/java:1"   '{"version":"17"}'  ''
add_component dotnet        "${IMAGE_PREFIX}dotnet:latest"          "${DEVCONTAINER_FEATURES}/dotnet:2" ''                  ''
add_component "dotnet:10.0" "${IMAGE_PREFIX}dotnet:10.0"            "${DEVCONTAINER_FEATURES}/dotnet:2" '{"version":"10.0"}' ''
add_component "dotnet:9.0"  "${IMAGE_PREFIX}dotnet:9.0"             "${DEVCONTAINER_FEATURES}/dotnet:2" '{"version":"9.0"}' ''
add_component "dotnet:8.0"  "${IMAGE_PREFIX}dotnet:8.0"             "${DEVCONTAINER_FEATURES}/dotnet:2" '{"version":"8.0"}' ''
add_component ruby          "${IMAGE_PREFIX}ruby:latest"            "${DEVCONTAINER_FEATURES}/ruby:2"   ''                  ''
add_component "ruby:3.4"    "${IMAGE_PREFIX}ruby:3.4"               "${DEVCONTAINER_FEATURES}/ruby:2"   '{"version":"3.4"}' ''
add_component "ruby:3.3"    "${IMAGE_PREFIX}ruby:3.3"               "${DEVCONTAINER_FEATURES}/ruby:2"   '{"version":"3.3"}' ''
add_component "ruby:3.2"    "${IMAGE_PREFIX}ruby:3.2"               "${DEVCONTAINER_FEATURES}/ruby:2"   '{"version":"3.2"}' ''
add_component php           "${IMAGE_PREFIX}php:latest"             "${DEVCONTAINER_FEATURES}/php:1"    ''                  ''
add_component "php:8.5"     "${IMAGE_PREFIX}php:8.5"                "${DEVCONTAINER_FEATURES}/php:1"    '{"version":"8.5"}' ''
add_component "php:8.4"     "${IMAGE_PREFIX}php:8.4"                "${DEVCONTAINER_FEATURES}/php:1"    '{"version":"8.4"}' ''
add_component "php:8.3"     "${IMAGE_PREFIX}php:8.3"                "${DEVCONTAINER_FEATURES}/php:1"    '{"version":"8.3"}' ''
# There is no cpp Feature, so cpp is an image-only component.
add_component cpp           "${IMAGE_PREFIX}cpp:latest"             ''                                  ''                  ''
add_component opencode      ''                                      "$FEATURE_PREFIX/opencode:0"        ''                  opencode
add_component codex         ''                                      "$FEATURE_PREFIX/codex:0"           ''                  'codex --no-daemon'
add_component claude        ''                                      "$FEATURE_PREFIX/claude-code:0"     ''                  claude
add_component tmux          ''                                      "$FEATURE_PREFIX/tmux:0"            ''                  tmux
add_component vim           ''                                      "$FEATURE_PREFIX/vim:0"             ''                  vim
add_component playwright    ''                                      "$FEATURE_PREFIX/playwright:0"      ''                  ''
add_component gitlab-cli    ''                                      "$FEATURE_PREFIX/gitlab-cli:0"      ''                  ''
add_component github-cli    ''                                      "${DEVCONTAINER_FEATURES}/github-cli:1" ''              ''

# Strip the known registry prefixes so the help reads as python:latest,
# python:1 and so on.
short_ref() {
  case "$1" in
    "$IMAGE_PREFIX"*) printf '%s' "${1#"$IMAGE_PREFIX"}" ;;
    "$DEVCONTAINER_FEATURES"/*) printf '%s' "${1#"$DEVCONTAINER_FEATURES"/}" ;;
    "$FEATURE_PREFIX"/*) printf '%s' "${1#"$FEATURE_PREFIX"/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

component_list() {
  local name detail
  for name in "${COMPONENT_NAMES[@]}"; do
    detail=''
    if [[ -n "${COMPONENT_IMAGE[$name]}" ]]; then
      detail="image $(short_ref "${COMPONENT_IMAGE[$name]}")"
    fi
    if [[ -n "${COMPONENT_FEATURE[$name]}" ]]; then
      detail+="${detail:+ / }feature $(short_ref "${COMPONENT_FEATURE[$name]}")"
    fi
    if [[ -n "${COMPONENT_FEATURE_OPTIONS[$name]}" ]]; then
      detail+=" ${COMPONENT_FEATURE_OPTIONS[$name]}"
    fi
    [[ -n "$detail" ]] || detail='(nothing)'
    printf '  %-12s %-60s %s\n' "$name" "$detail" "${COMPONENT_COMMAND[$name]:--}"
  done
}

usage() {
  cat <<HELP
Usage: dcs [OPTIONS] [COMPONENT[,COMPONENT...]] [COMMAND [ARG ...]]

Run a command in a new, disposable Dev Container.

  --image IMAGE       Base image (counts as an image set before the components)
  --feature REF       Add a Dev Container Feature by full reference (repeatable)
  -h, --help          Show this help
Options come before the component list. After the component list, all remaining
arguments are the container command and its arguments; `--` may be used as an
optional separator. A command requires a component; use 'dcs base COMMAND' for
a command on the plain base image. With no arguments, 'dcs' starts a bash shell.

Components (name, what it adds, default command):
$(component_list)

Name zero or more components, separated by commas. They are processed in order:
a component that carries an image sets it when no image is set yet, and its
Feature is added otherwise. An image-only component such as cpp must come
before the image is set, because it has no Feature to layer. So
'dcs python,node' uses the Python image and adds the Node Feature, and both
languages are available. A versioned component such as 'python:3.12' or
'node:22' pins the version, using its image when it comes first and the
Feature's version option otherwise. The first component that carries a command
is run, and bash runs when none does. base is appended as the fallback when it
is not named, so 'dcs' alone starts a bash shell.

Everything after the component list is the container command, replacing the
component's default command (for example, 'dcs opencode bash'). The current
working directory is passed to Dev Container CLI as the workspace folder; the
container is deleted on exit while built images may remain cached.
HELP
}

die() { printf 'dcs: %s\n' "$*" >&2; exit 1; }

components_arg=''
image_option=''
features=()
run_command=()
components_seen=0
while (($#)); do
  # Options come before the component list. Everything after it is the
  # container command, replacing the component's default command.
  if ((components_seen == 1)); then
    if [[ "$1" == -- ]]; then
      shift
    fi
    run_command=("$@")
    break
  fi
  case "$1" in
    --image|--feature)
      opt="$1"
      (($# >= 2)) || die "missing value for $opt"
      [[ -n "$2" && "$2" != --* ]] || die "missing value for $opt"
      if [[ "$opt" == --image ]]; then image_option="$2"; else features+=("$2"); fi
      shift 2 ;;
    --) die "missing component list before --" ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *)
      # The first non-option argument is the component list.
      components_arg="$1"
      components_seen=1
      shift ;;
  esac
done

component_names=()
if [[ -n "$components_arg" ]]; then
  IFS=',' read -r -a component_names <<< "$components_arg"
fi

# Validate every token against the component table. base stays where it is when
# named, and is appended otherwise so it is always available as a fallback.
selected=()
base_present=0
if ((${#component_names[@]})); then
  for name in "${component_names[@]}"; do
    [[ -n "$name" ]] || { usage >&2; die "empty component name in: $components_arg"; }
    if [[ -n "${COMPONENT_FEATURE[$name]+x}" ]]; then
      [[ "$name" == base ]] && base_present=1
      selected+=("$name")
    else
      usage >&2
      die "unknown component: $name"
    fi
  done
fi
((base_present)) || selected+=(base)
component_names=("${selected[@]}")

# Resolve the image, the default command and the Feature set in one ordered
# pass. A component contributes its image when none is set yet; otherwise its
# Feature is added (so a language can be layered onto another language's
# image). --image counts as an already-set image.
resolved_image="$image_option"
default_command=()
declare -A seen_components=()
declare -A seen_features=()
declare -A feature_options=()
all_features=()
for name in "${component_names[@]}"; do
  [[ -z "${seen_components[$name]:-}" ]] || continue
  seen_components[$name]=1
  contributed=0
  if [[ -n "${COMPONENT_IMAGE[$name]}" && -z "$resolved_image" ]]; then
    # This component provides the image, so its Feature is already included.
    resolved_image="${COMPONENT_IMAGE[$name]}"
    contributed=1
  elif [[ -n "${COMPONENT_FEATURE[$name]}" ]]; then
    feature="${COMPONENT_FEATURE[$name]}"
    contributed=1
    if [[ -z "${seen_features[$feature]+x}" ]]; then
      seen_features[$feature]=1
      all_features+=("$feature")
      feature_options[$feature]="${COMPONENT_FEATURE_OPTIONS[$name]}"
    fi
  fi
  if ((contributed == 0)) && [[ "$name" != base ]]; then
    if [[ -n "${COMPONENT_IMAGE[$name]}" ]]; then
      die "component '$name' adds nothing on image '$(short_ref "$resolved_image")'; it has no Feature to layer"
    fi
    die "component '$name' adds nothing: it has no image or Feature"
  fi
  if ((${#default_command[@]} == 0)) && [[ -n "${COMPONENT_COMMAND[$name]}" ]]; then
    read -r -a default_command <<< "${COMPONENT_COMMAND[$name]}"
  fi
done
if ((${#features[@]})); then
  for feature in "${features[@]}"; do
    if [[ -z "${seen_features[$feature]+x}" ]]; then
      seen_features[$feature]=1
      all_features+=("$feature")
      feature_options[$feature]=''
    fi
  done
fi

image="$resolved_image"
[[ -n "$image" ]] || image="$DEFAULT_IMAGE"

if ((${#run_command[@]} == 0)); then
  if ((${#default_command[@]})); then
    run_command=("${default_command[@]}")
  else
    run_command=(bash)
  fi
fi

for cmd in docker devcontainer; do
  command -v "$cmd" >/dev/null 2>&1 || die "$cmd is required"
done

docker info >/dev/null 2>&1 || die 'cannot connect to Docker; check the daemon and permissions'

workspace="$(pwd -P)"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/dcs.XXXXXXXX")" || die 'unable to create temporary directory'
readonly tmp
session="$(cat /proc/sys/kernel/random/uuid)" || die 'unable to generate a session ID'
readonly session

cleanup() {
  local status=$?
  trap - EXIT INT TERM
  # Keep the wrapped command's exit status even if cleanup itself fails.
  set +e
  local ids
  if ! ids="$(docker ps -aq --filter "label=dcs.session=$session")"; then
    printf 'dcs: warning: unable to locate containers for cleanup (session %s)\n' "$session" >&2
  elif [[ -n "$ids" ]]; then
    # IDs are Docker-generated hex tokens, one per line.
    local id
    while IFS= read -r id; do
      if [[ -n "$id" ]] && ! docker rm -f "$id" >/dev/null; then
        printf 'dcs: warning: failed to remove container %s\n' "$id" >&2
      fi
    done <<< "$ids"
  fi
  rm -rf -- "$tmp"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Emit a JSON string. Values are image and Feature references, so escaping \\
# and " is enough; shell data is never interpolated unescaped.
json_string() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

{
  printf '{\n'
  printf '  "name": "dcs sandbox",\n'
  printf '  "image": %s,\n' "$(json_string "$image")"
  printf '  "features": {'
  separator=''
  if ((${#all_features[@]})); then
    for feature in "${all_features[@]}"; do
      options="${feature_options[$feature]:-}"
      [[ -n "$options" ]] || options='{}'
      printf '%s%s: %s' "$separator" "$(json_string "$feature")" "$options"
      separator=', '
    done
  fi
  printf '}\n'
  printf '}\n'
} > "$tmp/devcontainer.json"

printf 'dcs: creating a disposable container for %s\n' "$workspace" >&2

# Use an explicit external config to ignore any existing workspace .devcontainer.
# --id-label guarantees concurrent runs never share/reuse the same container.
# devcontainer up writes its JSON result to stdout. Capture it so it does not
# pollute the wrapped command's output, and replay it on stderr if startup
# fails (keeping the CLI's exit status).
up_output="$(devcontainer up \
  --workspace-folder "$workspace" \
  --config "$tmp/devcontainer.json" \
  --id-label "dcs.session=$session" \
  --no-lockfile)" || {
  up_status=$?
  if [[ -n "$up_output" ]]; then
    printf '%s\n' "$up_output" >&2
  fi
  printf 'dcs: devcontainer up failed\n' >&2
  exit "$up_status"
}

# Do not replace this shell: the EXIT trap must remove the container.
# exec looks the container up from the same dcs.session label.
status=0
devcontainer exec \
  --workspace-folder "$workspace" \
  --config "$tmp/devcontainer.json" \
  --id-label "dcs.session=$session" \
  -- "${run_command[@]}" || status=$?
exit "$status"
